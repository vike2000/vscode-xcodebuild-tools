// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "build",
			"type": "npm",
			"script": "build",
			"problemMatcher": "$tsc",
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"type": "npm",
			"script": "watch",
			"problemMatcher": [
				"$tsc-watch"
			],
			"isBackground": true,
			"presentation": {
				"reveal": "never"
			},
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"label": "build using macports bash and ~vike/.bash_profile_paths",
			"type": "npm",
			"options": {
				"shell": {
					"executable": "/opt/local/bin/bash",
					"args": [
						"-c",
						". ~vike/.bash_profile_paths && npm run compile"
					]
				}
			},
			"script": "compile",
			"problemMatcher": [
				"$tsc"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"label": "watch using macports bash and ~vike/.bash_profile_paths",
			"type": "npm",
			"options": {
				"shell": {
					"executable": "/opt/local/bin/bash",
					"args": [
						"-c",
						". ~vike/.bash_profile_paths && npm run watch"
					]
				}
			},
			"script": "watch",
			"problemMatcher": [
				"$tsc-watch"
			],
			"isBackground": true,
			"presentation": {
				"reveal": "never"
			},
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"label": "build",
			"type": "npm",
			"script": "build",
			"problemMatcher": "$tsc",
			"group": {
				"kind": "build",
				"isDefault": true
			}
		}
	]
}
